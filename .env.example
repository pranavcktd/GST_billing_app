# development | production
APP_ENV=development

# Railway: copy the DATABASE_URL from your Railway PostgreSQL service ("Connect" tab).
# Local dev without Postgres: leave as SQLite.
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql://postgres:<password>@<host>.railway.app:<port>/railway

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Cloudinary dashboard -> API Environment variable
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=gst-billing

# E-mail backups (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=<app-password>
SMTP_FROM=you@gmail.com

# Subscriptions via Razorpay (leave empty locally: APP_ENV=development simulates payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# e-Invoice / e-Way Bill: sandbox (test IRNs, no government call) or gsp
EINVOICE_PROVIDER=sandbox
GSP_BASE_URL=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
